DISCORD_TOKEN=paste-bot-token-here
# Your test server's ID makes commands appear instantly. Leave blank to register globally (can take up to an hour).
GUILD_ID=
ADMIN_ROLE=admin
DB_PATH=game.db
# Nightly tick time and timezone
TICK_TIME=02:00
TICK_TZ=America/Denver
# For the playtest: tick every N minutes instead of nightly (leave blank for nightly)
TICK_MINUTES=
# Send each player their private night report as a DM (1 = yes, 0 = no)
DM_REPORTS=1
# Automatic updates wait until nobody has used the bot for this many minutes (and no tick is near)
AUTO_UPDATE_QUIET_MINUTES=10
