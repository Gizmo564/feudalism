DISCORD_TOKEN=paste-bot-token-here
# Leave blank so every server the bot joins can use it (commands are registered globally, which can take a while to
# appear). Filling in one server's ID makes commands appear instantly there, but ONLY there.
GUILD_ID=
ADMIN_ROLE=admin
# Every Discord server the bot joins gets its own game, saved in this folder as <server id>.db
GAMES_DIR=games
# The most games the bot will run at once (check `feudalism games` to see how busy the box is)
MAX_GAMES=20
# Nightly tick time and timezone, and the admin role above, are the defaults. Each server's admins can change their
# own with /admin settings.
TICK_TIME=02:00
TICK_TZ=America/Denver
# For the playtest: tick every N minutes instead of nightly (leave blank for nightly)
TICK_MINUTES=
# Send each player their private night report as a DM (1 = yes, 0 = no)
DM_REPORTS=1

# Discord Activity (experimental map inside Discord, see ACTIVITY.md). Leave blank to keep it off.
ACTIVITY_PORT=
DISCORD_CLIENT_SECRET=

# Automatic updates wait until nobody has used the bot for this many minutes (and no tick is near)
AUTO_UPDATE_QUIET_MINUTES=10
# Phone notifications through ntfy (updates, crashes, failed ticks). Pick a hard-to-guess topic name,
# subscribe to it in the ntfy app, and put it here. Blank means off.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_NAME=Crownfall
